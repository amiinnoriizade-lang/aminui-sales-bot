# Telegram
BOT_TOKEN=
# Numeric Telegram user ID(s), comma-separated. Example: 123456789,987654321
ADMIN_IDS=

# VPN-UI panel (base URL without trailing slash)
VPNUI_BASE_URL=https://YOUR-PANEL-DOMAIN:PORT
VPNUI_USERNAME=
VPNUI_PASSWORD=
VPNUI_VERIFY_TLS=true

# Required public VPN IP or domain reachable by customers
VPN_PUBLIC_HOST=

# Generated automatically by install.sh if left empty. Keep this key safe and backed up.
APP_ENCRYPTION_KEY=

DATABASE_PATH=./data/bot.sqlite3

# Optional initial plans as JSON array. Leave [] to create plans from the Telegram admin menu.
# Example: [{"code":"vless-1m-10g","protocol":"vless","volume_gb":10,"months":1,"price":100000}]
DEFAULT_PLANS_JSON=[]
