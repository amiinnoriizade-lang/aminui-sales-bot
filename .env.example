# Telegram
BOT_TOKEN=
# Numeric Telegram user ID(s), comma-separated. Example: 123456789,987654321
ADMIN_IDS=

# VPN-UI panel (base URL without trailing slash)
VPNUI_BASE_URL=https://YOUR-PANEL-DOMAIN:PORT
VPNUI_USERNAME=
VPNUI_PASSWORD=
VPNUI_VERIFY_TLS=true

# Optional defaults. Set inbound IDs only if you want to pre-bind default VLESS/L2TP plans.
VPNUI_VLESS_INBOUND_ID=0
VPNUI_L2TP_INBOUND_ID=0
VPN_PUBLIC_HOST=

# Generated automatically by install.sh if left empty. Keep this key safe and backed up.
APP_ENCRYPTION_KEY=

# Payment details (optional; can also be configured in the Telegram admin menu)
CARD_NUMBER=
CARDHOLDER_NAME=
PAYMENT_INSTRUCTIONS=رسید کارت‌به‌کارت را ارسال کنید.

# Keep true until panel connectivity and configuration have been checked.
# Real account creation is blocked while true.
DRY_RUN=true

DATABASE_PATH=./data/bot.sqlite3

# Optional initial plans as JSON array. Leave [] to create plans from the Telegram admin menu.
# Example: [{"code":"vless-1m-10g","protocol":"vless","volume_gb":10,"months":1,"price":100000}]
DEFAULT_PLANS_JSON=[]
