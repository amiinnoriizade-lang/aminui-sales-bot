[Unit]
Description=AminUI Telegram Sales Bot
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/aminui-sales-bot
ExecStart=/opt/aminui-sales-bot/.venv/bin/python /opt/aminui-sales-bot/run.py
Restart=on-failure
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aminui-sales-bot
[Install]
WantedBy=multi-user.target
